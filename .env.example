# Server
PORT=3000
NODE_ENV=production

# LINE Official Account
# Get these from LINE Developers Console: https://developers.line.biz/
LINE_CHANNEL_ID=your_channel_id_here
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# Supabase
# Get these from Supabase Dashboard: https://supabase.com/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: Supabase Storage (for file uploads)
SUPABASE_STORAGE_BUCKET=rental-manager-uploads
